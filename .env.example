# ---- Mobile app (public Firebase web config; safe to ship in the app) ----
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_CONTACT_EMAIL=

# ---- Pipeline (GitHub Actions secrets / local .env; never commit values) ----
# Either the full service-account key JSON on one line (CI secret)…
FIREBASE_SERVICE_ACCOUNT=
# …or, locally, the path to the downloaded key file (keep it out of git)
FIREBASE_SERVICE_ACCOUNT_FILE=
GEMINI_API_KEY=
# Current free-tier Flash-Lite model id; check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=
GEMINI_RPM=10
GEMINI_MAX_CALLS=400
PIPELINE_MAX_WRITES=18000
CRAWLER_CONTACT_URL=https://github.com/a019956/cflog#bot
CONTACT_EMAIL=
